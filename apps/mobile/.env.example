# 선택 사항: 실제 기기에서는 같은 Wi-Fi의 개발 PC 주소나 배포 URL을 사용합니다.
# 비워두면 iOS는 localhost, Android 에뮬레이터는 10.0.2.2를 자동 사용합니다.
# EXPO_PUBLIC_WEB_URL=http://192.168.0.10:3000

# 공개 Supabase 프로젝트 URL(모바일 번들에 노출해도 안전한 값).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key(service_role 키는 절대 사용하지 않음).
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
