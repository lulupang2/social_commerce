{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-native",
    "lib": ["dom", "esnext"],
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "typeRoots": ["../../packages/domain/node_modules/@types", "../../node_modules/@types"],
    "types": ["node"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/webview/**/*.ts",
    "components/webview/**/*.tsx",
    "lib/format.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "env.d.ts"
  ],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.test.mts"]
}
