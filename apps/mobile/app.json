{
  "expo": {
    "name": "SummerGear",
    "slug": "summergear",
    "version": "0.2.0",
    "orientation": "portrait",
    "scheme": "summergear",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "판매글과 커뮤니티에 사진을 추가하려면 사진 접근 권한이 필요합니다.",
          "cameraPermission": "장비 사진을 바로 촬영하려면 카메라 접근 권한이 필요합니다.",
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Pretendard-Regular.otf",
            "./assets/fonts/Pretendard-SemiBold.otf",
            "./assets/fonts/Pretendard-Bold.otf",
            "./assets/fonts/Paperlogy-7Bold.ttf",
            "./assets/fonts/Paperlogy-8ExtraBold.ttf",
            "./assets/fonts/BarlowCondensed-Bold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F8FA"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
