# 개발 중 Next.js가 같은 출처 /api/v1 요청을 Go API로 전달할 때 사용합니다.
# 운영에서 별도 reverse proxy가 /api/v1을 처리하면 생략할 수 있습니다.
SUMMERGEAR_GO_API_ORIGIN=http://127.0.0.1:8080

# 공개 Supabase 프로젝트 URL(브라우저 코드에 노출해도 안전한 값).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key(service_role 키는 절대 사용하지 않음).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
