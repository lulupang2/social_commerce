# Go API / River FOUNDATION: test-only. Copy settings manually into the existing
# ~/.config/summergear/test.env (0600). Never overwrite it or commit real values.
APP_ENV=test
PAYMENT_MODE=test
# Explicit hosted TEST project, never production. The ID must match the
# DBA-provisioned summergear_meta.environment_guard marker (unique >=16 chars).
DB_TARGET=supabase-test
DB_TARGET_ID=

# TLS verify-full PostgreSQL URLs with distinct least-privilege login roles.
# API: summergear_api; worker: summergear_worker; migration: summergear_migrator.
# Supabase session pooler usernames may include the .project-ref suffix.
DATABASE_URL=
DATABASE_CONNECTION_MODE=direct
API_DB_MAX_CONNS=2
RIVER_DATABASE_URL=
RIVER_CONNECTION_MODE=direct
WORKER_DB_MAX_CONNS=5
MIGRATION_DATABASE_URL=
MIGRATION_DB_MAX_CONNS=3
# API transaction pooling is optional. Worker requires direct/session, not 6543.
# Supabase CA path may be provided via sslrootcert in each URL when required.
API_ADDR=127.0.0.1:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
RIVER_MAX_WORKERS=1
# NEVER enable against Supabase: only the disposable Docker fixture permits it.
FIXTURE_FAST_JOBS=false

# LOGIN / PAYMENT SETTINGS.
# Temporary login is test-only and should be disabled when real social login is enabled.
AUTH_DEV_LOGIN_ENABLED=false
PUBLIC_WEB_URL=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_SUCCESS_URL=
TOSS_FAIL_URL=
