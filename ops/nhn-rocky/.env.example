MIGRATION_DATABASE_URL=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
PAYMENT_MODE=test
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_SUCCESS_URL=
TOSS_FAIL_URL=
# Planned settings; final names and enforcement are implementation work.
RIVER_MAX_WORKERS=1
