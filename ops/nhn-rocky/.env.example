# Planned Go API / River test configuration. No current app reads this file yet.
# Copy to ~/.config/summergear/test.env on nhn-rocky; never commit actual values.
APP_ENV=test
PUBLIC_WEB_URL=
# PostgreSQL URLs with TLS: isolated Supabase TEST project only.
DATABASE_URL=
# Direct or session-pooler URL required for the River coordinator.
RIVER_DATABASE_URL=
